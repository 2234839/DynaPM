{
  "name": "@dynapm/gateway",
  "version": "1.0.15",
  "description": "DynaPM (formerly DynaPM) gateway: 智能网关 + 按需启动服务管理（Bun 运行时）。DynaPM is a dynamic start-stop application management tool with serverless-like features.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "dynapm": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun run test/run-all.ts",
    "test:correctness": "bun run test/test-correctness-fixes.ts",
    "test:timeout": "bun run test/test-timeout-paths.ts",
    "test:ws-siyuan": "bun run test/test-ws-siyuan.ts",
    "test:passthrough": "bun run test/test-passthrough.ts",
    "test:slow-client": "bun run test/test-slow-client-bun.ts",
    "test:keepwarm": "bun run test/test-keepwarm.ts",
    "test:sniffer": "bun run test/test-upgrade-sniffer.ts",
    "test:agent": "bun run test/test-agent-cleanup-bun.ts",
    "build": "bun build --compile --external giget --external jiti --external chokidar --external dotenv src/index.ts --outfile dist/dynapm",
    "publish2npm": "bun run ./script/updateVersion.ts && npm publish --registry=https://registry.npmjs.org",
    "runTestServer": "bun run ./test/services/echo-server.ts",
    "prebuild": "bun run script/patch-c12-runtime.ts"
  },
  "files": [
    "src/",
    "*.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "serverless",
    "pm2",
    "self-host",
    "bun"
  ],
  "author": "崮生",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/2234839/DynaPM.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "bun-types": "^1.4.2",
    "c12": "4.0.0-beta.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "chokidar": "^5.0.0",
    "ws": "^8.19.0"
  }
}

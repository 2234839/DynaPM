{
  "name": "@dynapm/gateway-bun",
  "version": "0.1.0",
  "description": "DynaPM (formerly DynaPM) gateway - Bun edition: Bun.serve + 原生 fetch 重写，行为与 Node+uWS 版对齐",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test test/ || bun run test/run-all.ts",
    "test:correctness": "bun run test/bun-test-correctness-fixes.ts",
    "test:timeout": "bun run test/bun-test-timeout-paths.ts",
    "test:ws-siyuan": "bun run test/bun-test-ws-siyuan.ts",
    "test:passthrough": "bun run test/bun-test-passthrough.ts",
    "test:slow-client": "bun run test/bun-test-slow-client.ts",
    "test:keepwarm": "bun run test/bun-test-keepwarm.ts",
    "test:sniffer": "bun run test/bun-test-upgrade-sniffer.ts",
    "test:agent": "bun run test/bun-test-agent-pool.ts",
    "build": "bun build --compile src/index.ts --outfile dist/dynapm-gateway-bun"
  },
  "dependencies": {
    "@dynapm/gateway": "workspace:*",
    "bun-types": "^1.4.2",
    "c12": "4.0.0-beta.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.19.0"
  }
}
